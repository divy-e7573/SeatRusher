# Copy this file to `apps/api/.env` and adjust if needed:
#   cp apps/api/.env.example apps/api/.env   (PowerShell: Copy-Item)
#
# `.env` is git-ignored and must NEVER be committed. Never put real production
# credentials here - these are local development placeholders only.

# development | test | production
NODE_ENV=development

# Interface the HTTP server binds to. 0.0.0.0 makes the API reachable from Docker
# containers and from your LAN as well as localhost.
HOST=0.0.0.0
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# true = human-readable logs (dev only), false = newline-delimited JSON.
# Leave unset to auto-select: pretty in development, JSON everywhere else.
# LOG_PRETTY=true

# Matches the credentials in the root docker-compose.yml defaults.
DATABASE_URL=postgres://seatrush:seatrush_dev_password@localhost:5432/seatrush
REDIS_URL=redis://localhost:6379

# How long a single dependency probe may take before it is reported as down.
HEALTH_CHECK_TIMEOUT_MS=2000

# --- Authentication -------------------------------------------------------
# Generate real secrets, do not copy these placeholders:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Run that twice: access and refresh MUST use different secrets.
JWT_ACCESS_SECRET=change-me-to-a-random-48-byte-value-0000000000000000
JWT_REFRESH_SECRET=change-me-to-a-different-random-48-byte-value-000000
JWT_ISSUER=seatrush-api

# Access token is short-lived on purpose: a stolen one expires quickly.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Set to true when serving over HTTPS. Leave unset to auto-select: true in
# production, false in development (plain HTTP localhost drops Secure cookies).
# COOKIE_SECURE=true

# Brute-force protection for the auth endpoints, per IP.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000

# --- Seat holds -----------------------------------------------------------
# PRD FR-3: a hold lasts 10 minutes, enforced by the Redis TTL on each seat key.
# Lower this only for testing; production must keep 600.
HOLD_TTL_SECONDS=600

# FR-8: rate limiting on the hold endpoints, keyed per authenticated user.
HOLD_RATE_LIMIT_MAX=30
HOLD_RATE_LIMIT_WINDOW_MS=60000
