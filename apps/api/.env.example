# Copy this file to `apps/api/.env` and adjust if needed:
#   cp apps/api/.env.example apps/api/.env   (PowerShell: Copy-Item)
#
# `.env` is git-ignored and must NEVER be committed. Never put real production
# credentials here - these are local development placeholders only.

# development | test | production
NODE_ENV=development

# Interface the HTTP server binds to. 0.0.0.0 makes the API reachable from Docker
# containers and from your LAN as well as localhost.
HOST=0.0.0.0
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# true = human-readable logs (dev only), false = newline-delimited JSON.
# Leave unset to auto-select: pretty in development, JSON everywhere else.
# LOG_PRETTY=true

# Matches the credentials in the root docker-compose.yml defaults.
DATABASE_URL=postgres://seatrush:seatrush_dev_password@localhost:5432/seatrush
REDIS_URL=redis://localhost:6379

# How long a single dependency probe may take before it is reported as down.
HEALTH_CHECK_TIMEOUT_MS=2000
